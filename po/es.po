#: src/v45-46-47-48-49-50/prefs.js:338
msgid "App Grid folders"
msgstr "Carpetas de la cuadrícula de apps"

#: src/v45-46-47-48-49-50/prefs.js:339
msgid ""
"Folders from the App Grid. Make one there by dragging an app onto another."
msgstr ""
"Carpetas de la cuadrícula de apps. Crea una allí arrastrando una app sobre "
"otra."

#: src/v45-46-47-48-49-50/prefs.js:382
msgid "No App Grid folders"
msgstr "No hay carpetas en la cuadrícula de apps"

#: src/v45-46-47-48-49-50/prefs.js:383
msgid "Open the App Grid and drag one app onto another to create a folder."
msgstr ""
"Abre la cuadrícula de apps y arrastra una app sobre otra para crear una "
"carpeta."

#: src/v45-46-47-48-49-50/prefs.js:392
msgid "Appearance"
msgstr "Apariencia"

#: src/v45-46-47-48-49-50/prefs.js:393
msgid "Drag a folder along the dock to place it between any apps."
msgstr ""
"Arrastra una carpeta por el dock para ponerla entre las apps que quieras."

#: src/v45-46-47-48-49-50/prefs.js:398
msgid "Separator"
msgstr "Separador"

#: src/v45-46-47-48-49-50/prefs.js:399
msgid "Draw a line before folders at the end of the dock"
msgstr "Dibujar una línea antes de las carpetas al final del dock"

#: src/v45-46-47-48-49-50/prefs.js:405
msgid "Popup columns"
msgstr "Columnas de la ventana emergente"

#: src/v45-46-47-48-49-50/prefs.js:406
msgid "Apps per row when a folder is opened"
msgstr "Apps por fila al abrir una carpeta"

#: src/v45-46-47-48-49-50/prefs.js:411
msgid "Hide pinned apps in App Grid folders"
msgstr "Ocultar apps ancladas en las carpetas de la cuadrícula"

#: src/v45-46-47-48-49-50/prefs.js:412
msgid "Like the App Grid, leave out apps already pinned to the dock"
msgstr "Como en la cuadrícula de apps, omitir las apps ya ancladas al dock"

#: src/v45-46-47-48-49-50/prefs.js:418
msgid "Reset positions"
msgstr "Restablecer posiciones"

#: src/v45-46-47-48-49-50/prefs.js:419
msgid "Move every folder back to the end of the dock"
msgstr "Devolver todas las carpetas al final del dock"

#: src/v45-46-47-48-49-50/prefs.js:421
msgid "Reset"
msgstr "Restablecer"
